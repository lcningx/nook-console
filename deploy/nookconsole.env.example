NODE_ENV=production
HOST=127.0.0.1
PORT=4790
NOOK_CONSOLE_BASE_PATH=/console
DATA_DIR=/root/.workspace/nook-console/data
DEFAULT_CWD=/root/.workspace
AGY_BIN=/root/.local/bin/agy
MAX_TERMINALS=12

# Cookie signing secret (change to a random 32+ char string)
NOOK_CONSOLE_AUTH_SECRET=change-me-to-random-secret

# Shared bearer token used by Nook server to mint one-time SSO tickets
NOOK_CONSOLE_SSO_TOKEN=change-me-to-random-sso-token

# Optional explicit password override. If omitted on first boot, Nook Console
# copies the password hash once from NOOK_CONSOLE_FALLBACK_NOOK_DB (if present),
# otherwise generates a random password saved to data/initial-password.txt.
# NOOK_CONSOLE_PASSWORD=
NOOK_CONSOLE_FALLBACK_NOOK_DB=/root/.workspace/nook/data/nook.sqlite
